rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(mapData) {
      return request.auth != null &&
        request.auth.token.email in mapData.memberEmails;
    }

    match /maps/{mapId} {
      allow read: if isMember(resource.data);
      // Anyone signed in can create a map, as long as they list themselves
      // (their own auth email) as a member on the doc they're creating.
      allow create: if request.auth != null &&
        request.auth.token.email in request.resource.data.memberEmails;
      allow update: if isMember(resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      match /pins/{pinId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/maps/$(mapId)).data);
      }
    }
  }
}
